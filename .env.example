# ============================================================
# Credenziali del pannello di regia SEO
# Copia questo file in .env.local e riempi i valori.
# .env.local NON va mai messo su GitHub.
# ============================================================

# --- Accesso al pannello -------------------------------------
PANNELLO_PASSWORD=
CRON_CHIAVE=
# Indirizzo pubblico del pannello. Su Hostinger evita il redirect verso 0.0.0.0.
PANNELLO_URL=https://seo.brignole.ch

# --- Database MySQL ------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Testi (Claude predefinito) ------------------------------
MODELLO_TESTI=claude
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=

# --- Google (perimetro Brignole) -----------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_MANAGER_ID=

# --- Google (Biography Library, identita SEPARATA) -----------
# Non riusare le chiavi Brignole. Grants e soldi tuoi non si mescolano.
BL_SERVICE_ACCOUNT_JSON=
BL_ADS_DEVELOPER_TOKEN=
BL_ADS_CUSTOMER_ID=
BL_ADS_MANAGER_ID=

# --- WordPress -----------------------------------------------
WP_AELLE_UTENTE=
WP_AELLE_PASSWORD_APP=
WP_BRIGNOLE_UTENTE=
WP_BRIGNOLE_PASSWORD_APP=
WP_BL_UTENTE=
WP_BL_PASSWORD_APP=

# --- Ecwid ---------------------------------------------------
ECWID_STORE_ID=127192517
ECWID_TOKEN=

# --- GitHub --------------------------------------------------
GITHUB_TOKEN=
