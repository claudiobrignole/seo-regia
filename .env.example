# ============================================================
# Credenziali del pannello di regia SEO
# Copia questo file in .env.local e riempi i valori.
# .env.local NON va mai messo su GitHub.
# ============================================================

# --- Accesso al pannello -------------------------------------
# Password unica per entrare nel pannello (scegline una lunga).
PANNELLO_PASSWORD=
# Chiave che protegge le rotte notturne: i lavori pianificati di
# hPanel devono passarla nell'intestazione x-chiave-cron.
CRON_CHIAVE=

# --- Database MySQL (incluso nel piano Hostinger) ------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Google (perimetro Brignole) -----------------------------
# Account di servizio: incolla il JSON su una riga sola.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# --- Google (Biography Library, identita separata) ------------
# Secondo account di servizio, creato nel progetto dell'associazione.
BL_SERVICE_ACCOUNT_JSON=
BL_ADS_CUSTOMER_ID=

# --- WordPress: una password applicativa per sito ------------
WP_AELLE_UTENTE=
WP_AELLE_PASSWORD_APP=
WP_BRIGNOLE_UTENTE=
WP_BRIGNOLE_PASSWORD_APP=
WP_BL_UTENTE=
WP_BL_PASSWORD_APP=

# --- Ecwid (un solo negozio: Aelle Store) --------------------
ECWID_STORE_ID=127192517
ECWID_TOKEN=

# --- GitHub: token limitato ai repository dei siti Node ------
GITHUB_TOKEN=
